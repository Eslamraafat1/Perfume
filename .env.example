# Supabase project (Project Settings → API). Both are public, browser-safe values.
# Never put the service_role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical public URL used for canonical links, sitemap.xml and robots.txt.
# Optional on Vercel (VERCEL_PROJECT_PRODUCTION_URL is used automatically).
NEXT_PUBLIC_SITE_URL=https://perfume-sooty-alpha.vercel.app
